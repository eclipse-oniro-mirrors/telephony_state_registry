# libtel_state_registry.z.so (SA 4009) symbol governance whitelist.
# SA libs are loaded by safwk via dlopen only (no dlsym lookup, see
# samgr parse_util.cpp); registration relies on static constructors.
# Whole-image cross reference (2109 SOs) shows no dynamic consumer of
# any other exported symbol: observers register over IPC via
# tel_state_registry_api. Note: __emutls_get_address (compiler runtime
# helper leaked into .dynsym) and OHOS::Telephony::g_registerResult
# (registration bookkeeping) are deliberately hidden; emutls users
# resolve it from their own toolchain providers.
# Keep the cross-DSO CFI entry plus inline-template singleton/delegator
# static members and their guards (DelayedSingleton / DelayedRefSingleton /
# Singleton / delegator_ / instance_), which must stay global to preserve
# cross-DSO singleton unification by the dynamic linker.

{
  global:
    _init;
    _fini;
    __cfi_check;
    extern "C++" {
      *DelayedSingleton*;
      *DelayedRefSingleton*;
      *Singleton*;
      *delegator_*;
      *instance_*;
    };
  local:
    *;
};
